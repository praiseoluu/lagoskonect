RewriteEngine On
RewriteBase /server/

# Allow direct access to uploads
RewriteCond %{REQUEST_URI} ^/server/uploads/
RewriteRule ^ - [L]

CGIPassAuth On

# Prevent internal redirect loops (Apache LimitInternalRecursion)
# Once index.php is reached, stop rewriting.
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/v1/(.*)$ index.php [QSA,L]
