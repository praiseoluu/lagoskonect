# Lagos Konnect — Apache Rewrite Rules
# ============================================================
# Rewrites every non-file, non-directory request to index.html
# so the SPA router can handle clean URLs on page reload.
#
# e.g. user refreshes at /home → Apache serves index.html
#      → JS router reads /home → mounts the Home page component
#
# NGINX equivalent (add to server block):
#   location / {
#     try_files $uri $uri/ /index.html;
#   }
#
# PHP backend API lives at /api/* — those pass through unmodified.

Options -MultiViews
RewriteEngine On

# ── Block known bot/scanner IPs and WordPress probe patterns ─────────
# These IPs have been observed running automated WordPress vulnerability
# scans against this site. They only receive 308 redirects so they cause
# no PHP load, but blocking them at the rewrite layer stops Apache
# processing them entirely and removes noise from access logs.
# Add/remove IPs as new scanners appear in your access logs.
RewriteCond %{REMOTE_ADDR} ^(159\.223\.62\.250|45\.32\.119\.175|143\.110\.186\.90|159\.89\.207\.20)$ [NC]
RewriteRule ^ - [F,L]

# Block WordPress-probe paths — this site has no WordPress installation.
# Any request for wp-includes/wlwmanifest.xml (or similar WP paths) is
# a scanner and should be rejected immediately without any redirect cost.
RewriteCond %{REQUEST_URI} wp-includes [NC,OR]
RewriteCond %{REQUEST_URI} wp-admin [NC,OR]
RewriteCond %{REQUEST_URI} wp-login [NC,OR]
RewriteCond %{REQUEST_URI} xmlrpc\.php [NC]
RewriteRule ^ - [F,L]

# Redirect HTTP to HTTPS (skip for localhost/127.0.0.1 development)
# R=308 preserves the HTTP method (POST stays POST — 301/302 convert POST→GET)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=308]

# ── Allow direct file access (assets, CSS, JS, etc.) ──────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Pass PHP API calls through to PHP ─────────────────────────────────
# The route segment is passed as _route= so server/index.php can read it
# from $_GET regardless of whether REDIRECT_URL or [END] are supported
# (varies between Apache and LiteSpeed on cPanel hosts).
RewriteCond %{REQUEST_URI} ^/server/api/v1/
RewriteRule ^server/api/v1/(.*)$ /server/index.php?_route=$1 [QSA,END]

# Allow direct server file access (uploads, etc.)
RewriteCond %{REQUEST_URI} ^/server/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Everything else → SPA entry point ─────────────────────────────────
RewriteRule ^ index.html [L]

# ── Security headers ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS filter
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS — force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy (tighten when going to production)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://maxcdn.bootstrapcdn.com https://fonts.googleapis.com; font-src 'self' https://maxcdn.bootstrapcdn.com https://fonts.gstatic.com; img-src 'self' data: blob: https://picsum.photos https://fastly.picsum.photos https://lh3.googleusercontent.com https://*.e2-object.com https://*.idrivee2.com; media-src 'self' blob: data: https://*.e2-object.com https://*.idrivee2.com; connect-src 'self' https://cdn.jsdelivr.net;"
</IfModule>

# ── Caching ────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — no cache (always fresh for the SPA shell)
  ExpiresByType text/html                 "access plus 0 seconds"
  # JS/CSS — revalidate on every load.
  #
  # These were cached for a year, and only /app.js carries a ?v= query. Every
  # other module and stylesheet is fetched from an unversioned URL, so once a
  # visitor had them they kept them: a browser could still be running months-old
  # JavaScript against a freshly deployed backend, which is exactly how a
  # retired endpoint ends up silently delivering nothing to real users.
  #
  # Revalidation costs one conditional request per file, answered with an empty
  # 304 when nothing changed, and static files never touch PHP so this does not
  # consume entry processes. Correctness is worth far more than the saved bytes.
  ExpiresByType application/javascript    "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 0 seconds"
  # Images / fonts
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# Belt and braces for the rule above: mod_expires is not guaranteed to be
# loaded on this host, and a blank Cache-Control leaves the browser to invent
# its own heuristic freshness. mod_headers is demonstrably active (it sets the
# CSP and HSTS above), so state the policy explicitly. "no-cache" does not mean
# "do not store" — the file is still cached, it just has to be revalidated,
# which normally returns an empty 304.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
